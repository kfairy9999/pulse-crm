{
  "name": "pulse-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private single-owner CRM with Cloudflare Workers, D1, and static React assets.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "start": "wrangler dev",
    "test": "node --import ./test/react-loader.js --test --test-concurrency=1 test/*.test.js test/*.test.jsx && vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "reset:sample": "node scripts/reset-sample-data.js",
    "dev:legacy": "concurrently -k -n API,WEB \"node --watch src/server/index.js\" \"vite --host 127.0.0.1\"",
    "start:legacy": "node src/server/index.js",
    "test:legacy": "node --import ./test/react-loader.js --test --test-concurrency=1 test/*.test.js test/*.test.jsx",
    "test:worker": "vitest run --config vitest.config.js",
    "check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "validate": "npm run test && npm run check",
    "test:smoke": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
